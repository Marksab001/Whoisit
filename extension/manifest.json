{
  "manifest_version": 3,
  "name": "whoisit — Instagram Relationship Checker",
  "version": "2.2.0",
  "minimum_chrome_version": "111",
  "description": "Private follower and following comparison using your local Instagram session or official data export.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "whoisit Instagram Checker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["config.js", "page-worker.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://cybroatrix.com/*",
        "https://www.cybroatrix.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
